{
  "name": "referral-review",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:hub": "pnpm --filter @rr/ui-hub dev",
    "build": "pnpm -r build",
    "build:hub": "pnpm --filter @rr/ui-hub build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "node scripts/check-boundaries.mjs && eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:web": "pnpm --filter @rr/web dev",
    "build:web": "pnpm --filter @rr/web build",
    "start:web": "pnpm --filter @rr/web start",
    "worker": "pnpm --filter @rr/worker start",
    "db:migrate": "pnpm --filter @rr/worker cli migrate",
    "db:seed": "pnpm --filter @rr/worker cli seed",
    "reconcile": "pnpm --filter @rr/worker cli reconcile",
    "e2e": "node e2e/journey.mjs",
    "e2e:security": "node e2e/security.mjs",
    "e2e:a11y": "node e2e/a11y.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.17.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "vite@<6.4.3": ">=6.4.3"
    }
  }
}
