# Copy to .env. Never commit real values. Everything here is read by @rr/config, which refuses to start in production if a required value is missing.

# --- site ---
NODE_ENV=production
APP_URL=https://tasks.example.com          # the public address; must be https in production (cookies are Secure)
TRUST_PROXY_HOPS=1                         # REQUIRED in production: reverse proxies in front of the app (0 = none). Wrong value = wrong rate limiting.

# --- secrets (generate each with: openssl rand -base64 48 / openssl rand -base64 32) ---
SESSION_SECRET=                            # 32+ characters: signs CSRF tokens and peppers one-time-code hashes
UPI_ENCRYPTION_KEY=                        # exactly 32 bytes, base64: encrypts UPI IDs at rest. Losing it makes stored UPI IDs unreadable.

# --- database (Vista, or any PostgreSQL 14+) ---
DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=1                             # 1 = require TLS and verify the certificate
AUTO_MIGRATE=1                             # apply migrations at start (safe with several instances). Set 0 if Vista runs migrations.

# --- email: one-time codes only, plain text ---
EMAIL_MODE=smtp
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Task board <no-reply@example.com>"

# --- files: screenshots live here. Mount a persistent volume. ---
UPLOAD_DIR=/data/uploads

# --- AI scripts (optional). Without a key, admins cannot publish AI-script tasks. ---
# AI is not connected yet. Both must be set to turn it on; AI_MODEL is the exact model id from the provider.
ANTHROPIC_API_KEY=
AI_MODEL=

# --- first owner account, created on first start if missing (never overwrites an existing password) ---
OWNER_EMAIL=
OWNER_NAME=Owner
OWNER_PASSWORD=                            # at least 8 characters; change it after first login

# --- optional ---
SESSION_IDLE_HOURS=168                       # logged out after this many hours without a visit (168 = one week); every visit restarts the count
MAX_IDENTITIES_PER_USER=10

# ALERT_WEBHOOK_URL=https://hooks.slack.com/...   # optional: errors and money mismatches are posted here (Slack, Discord, any JSON webhook)
# DEV_LOGIN=1 (set by `npm run dev` only) adds one-click demo sign-in at /dev. The site refuses to start with it on in production.
# Local development needs none of the above: run `npm run dev` (it also loads this file). It uses an embedded database (.data/), prints codes to the console,
# and fills in throwaway secrets. For development with a seeded owner, set OWNER_EMAIL and OWNER_PASSWORD only.
